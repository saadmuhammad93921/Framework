# Non-secret configuration. Copy to .env and fill in.
# Agents may read this file. Put credentials in .env.secrets instead.

# Application under test (staging/test only, never production)
APP_URL=https://staging.your-app.example.com
APP_ENV=staging

# Optional: API layer
API_BASE_URL=https://api.staging.your-app.example.com

# Optional: Figma file or frame link to compare the UI against during execution
FIGMA_URL=
