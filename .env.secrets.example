# Credentials. Copy to .env.secrets and fill in. Never commit, agents never read it.
#
# Playwright MCP loads this file with --secrets: an agent types the variable NAME
# (e.g. ROLE_ADMIN_PASSWORD), the browser receives the real value, and the value
# is redacted from everything the model sees.
#
# One pair per role, named ROLE_<ROLE_NAME>_EMAIL / ROLE_<ROLE_NAME>_PASSWORD.
# ROLE_NAME is the role from context/roles.md in UPPER_SNAKE_CASE.

ROLE_ADMIN_EMAIL=
ROLE_ADMIN_PASSWORD=

# Optional
API_KEY=
FIGMA_API_KEY=
